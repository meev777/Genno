# Egress lockdown for the Genno container subnet (pinned in docker-compose.yml)
table inet genno {
  chain forward {
    type filter hook forward priority -10; policy accept;
    ip saddr 172.30.50.0/24 ct state established,related accept
    ip saddr 172.30.50.0/24 counter log prefix "genno-egress-drop " drop
  }
}
